# PlaceTrack Server Environment Variables
# Copy this file to placement-tracker/server/.env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placement_tracker?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application Origin (for CORS)
CLIENT_URL=http://localhost:3000

# Optional: Google Gemini AI Integration (for ATS Resume Scorer & Mock Interview)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Nodemailer Email Notifications (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
